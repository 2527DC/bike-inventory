// ---- Customers & Receivables ----

// The single customer record, shared by the inventory and service sides of the app.
//
// `phone` is required AND unique: one customer, one number. Required matters as much as
// unique here — a nullable unique column still permits unlimited NULL rows in Postgres, so
// the constraint alone would not actually prevent duplicate walk-in records.
model Customer {
  id        String       @id @default(cuid())
  name      String
  phone     String       @unique
  whatsapp  String? // merged in from the service app's Customer
  email     String?
  address   String?
  type      CustomerType @default(WALK_IN)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  invoices CustomerInvoice[]
  payments CustomerPayment[]

  // Service side
  serviceJobs    ServiceJob[]
  serviceReviews Review[]

  @@index([name])
}

model CustomerInvoice {
  id          String        @id @default(cuid())
  customerId  String
  customer    Customer      @relation(fields: [customerId], references: [id])
  invoiceNo   String        @unique
  invoiceDate DateTime
  dueDate     DateTime
  amount      Float
  paidAmount  Float         @default(0)
  status      InvoiceStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payments CustomerPayment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model CustomerPayment {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id])
  invoiceId    String?
  invoice      CustomerInvoice? @relation(fields: [invoiceId], references: [id])
  amount       Float
  paymentMode  PaymentMode
  paymentDate  DateTime
  referenceNo  String?
  notes        String?
  recordedById String
  recordedBy   User             @relation("CustomerPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// ---- Vendor Issues ----

model VendorIssue {
  id                  String            @id @default(cuid())
  issueSource         IssueSource       @default(VENDOR)
  vendorId            String?
  vendor              Vendor?           @relation(fields: [vendorId], references: [id])
  clientName          String?
  clientPhone         String?
  issueNo             String            @unique // ISS-YYYYMM-NNNN
  ticketNo            String? // Brand's own ticket/reference number (e.g. eMotorad) — shown in the WhatsApp message
  serviceLocation     String? // IN_STORE (cycle at store) | CUSTOMER (cycle with customer) — shown in the WhatsApp message
  issueType           IssueType
  description         String
  status              IssueStatus       @default(OPEN)
  priority            IssuePriority     @default(MEDIUM)
  billId              String?
  bill                VendorBill?       @relation(fields: [billId], references: [id])
  photoUrls           String[]
  docLink             String? // optional supporting document/spreadsheet link for the brand to verify
  suggestedResolution String?
  resolution          String?
  resolvedAt          DateTime?
  createdById         String
  createdBy           User              @relation("IssueCreatedBy", fields: [createdById], references: [id])
  notes               VendorIssueNote[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([issueSource])
}

// Append-only follow-up log on an issue — Hamsa/Suma add a timestamped note each time they chase
// the brand, so the full follow-up history (and stage progress) is tracked, not just one resolution.
model VendorIssueNote {
  id        String      @id @default(cuid())
  issueId   String
  issue     VendorIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  text      String
  authorId  String
  author    User        @relation("IssueNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([issueId])
}

enum IssueSource {
  VENDOR
  CLIENT
}

enum DeliveryStatus {
  PENDING
  VERIFIED
  WALK_OUT
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  FLAGGED
  PREBOOKED
  PACKED
