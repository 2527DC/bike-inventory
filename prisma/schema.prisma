generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CEO
  ADMIN
  SUPERVISOR
  PURCHASE_MANAGER
  ACCOUNTS_MANAGER
  INWARDS_EXECUTIVE
  OUTWARDS_EXECUTIVE
  STORE_MANAGER
  SALES_MANAGER
  SERVICE_MANAGER
  CUSTOM
}

enum TransactionType {
  INWARD
  OUTWARD
  TRANSFER
  ADJUSTMENT
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
  RGP_OUT
  TRANSFERRED
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_TO_VENDOR
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum BillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
}

enum PaymentMode {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  CREDIT_ADJUSTMENT
}

enum ExpenseCategory {
  DELIVERY
  TRANSPORT
  SHOP_MAINTENANCE
  UTILITIES
  SALARY_ADVANCE
  FOOD_TEA
  STATIONERY
  MISCELLANEOUS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum CustomerType {
  WALK_IN
  REGULAR
  DEALER
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum IssueType {
  QUALITY
  SHORTAGE
  DAMAGE
  WRONG_ITEM
  BILLING_ERROR
  DELIVERY_DELAY
  OTHER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProductCondition {
  NEW
  REFURBISHED_EXCELLENT
  REFURBISHED_GOOD
  REFURBISHED_FAIR
  DAMAGED
}

enum ProductType {
  BICYCLE
  SPARE_PART
  ACCESSORY
  BOX_PIECE
  WIP
  FINISHED_GOOD
}

// Active stock-tracking locations. Bins (see Bin model) are dormant; per-location
// quantity lives in StockLevel keyed by this enum. Two sites (BCH, BCC), each with
// a warehouse and a store. STORE/WAREHOUSE are legacy values kept only so old rows
// migrate cleanly — they are no longer used by the app.
enum StockLocation {
  STORE
  WAREHOUSE
  BCH_WAREHOUSE
  BCH_STORE
  BCC_WAREHOUSE
  BCC_STORE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          Role
  customRoleName String?
  permissions   Json?
  accessCode    String    @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  transactions  InventoryTransaction[]
  stockCounts   StockCount[]

  createdPOs       PurchaseOrder[]  @relation("POCreatedBy")
  approvedPOs      PurchaseOrder[]  @relation("POApprovedBy")
  recordedPayments VendorPayment[]  @relation("PaymentRecordedBy")
  recordedExpenses Expense[]        @relation("ExpenseRecordedBy")
  recordedCustomerPayments CustomerPayment[] @relation("CustomerPaymentRecordedBy")
  createdIssues    VendorIssue[]    @relation("IssueCreatedBy")
  issueNotes       VendorIssueNote[] @relation("IssueNoteAuthor")
  navTabs          String[]         @default([]) // admin-chosen bottom-nav hrefs (empty = role default)
  approvedStockCounts StockCount[] @relation("StockCountApprovedBy")
  verifiedDeliveries  Delivery[]   @relation("DeliveryVerifiedBy")
  uploadedStatements  BankStatement[] @relation("StatementUploader")

  // Service tickets


  // Service jobs


  // Transfer orders
  createdTransfers  TransferOrder[]     @relation("TransferCreatedBy")
  reviewedTransfers TransferOrder[]     @relation("TransferReviewedBy")

  // Second-hand cycles
  createdSecondHand  SecondHandCycle[]   @relation("SecondHandCreatedBy")
  verifiedSecondHand SecondHandCycle[]   @relation("SecondHandVerifiedBy")

  // Inbound shipments
  createdInboundShipments   InboundShipment[] @relation("InboundCreatedBy")
  approvedInboundShipments  InboundShipment[] @relation("InboundApprovedBy")
  deliveredInboundShipments InboundShipment[] @relation("InboundDeliveredBy")
  putawayInboundShipments   InboundShipment[] @relation("InboundPutawayBy")

  // Pre-bookings
  createdPreBookings PreBooking[] @relation("PreBookingCreatedBy")

  // POS settlements
  verifiedSettlements DailySettlement[] @relation("SettlementCashVerifier")

  // Operations Hub (Tasks, SOPs, Updates)
  postedUpdates      StoreUpdate[]   @relation("UpdatePostedBy")
  opsActivityLogs    OpsActivityLog[] @relation("OpsActivityLoggedBy")
  brandStockUploads  BrandStockUpload[] @relation("BrandStockUploadedBy")
  reportedProblems   AppProblem[]       @relation("ProblemReportedBy")
}

model Category {
  id            String    @id @default(cuid())
  name          String    @unique
  description   String?
  parentId      String?
  parent        Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  movingLevel   String    @default("NORMAL") // FAST, NORMAL, SLOW
  reorderLevel  Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
}

model Brand {
  id            String    @id @default(cuid())
  name          String    @unique
  contactName   String?
  contactPhone  String?
  whatsappNumber String?
  cdTermsDays   Int?      // Cash Discount terms in days
  cdPercentage  Float?    // Cash Discount percentage
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
  leadTime      BrandLeadTime?
  inboundShipments InboundShipment[]
  preBookings     PreBooking[]
  stockUploads    BrandStockUpload[] @relation("BrandStockUploads")
  skuMappings     BrandSkuMapping[]  @relation("BrandSkuMappings")
}

model Product {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  description   String?
  zohoItemId    String?        @unique // Zoho Books item_id for sync
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  brandId       String
  brand         Brand          @relation(fields: [brandId], references: [id])
  type          ProductType    @default(SPARE_PART)
  status        ProductStatus  @default(ACTIVE)
  condition     ProductCondition @default(NEW)

  // Pricing
  costPrice     Float          @default(0)
  sellingPrice  Float          @default(0)
  mrp           Float          @default(0)
  gstRate       Float          @default(18)
  hsnCode       String?

  // Stock
  currentStock  Int            @default(0)
  reservedStock Int            @default(0)
  minStock      Int            @default(0)
  maxStock      Int            @default(0)
  reorderLevel  Int            @default(0)
  reorderQty    Int            @default(0)

  // Bicycle specific
  size          String?        // For bicycles: 16", 20", 24", 26", etc.
  color         String?
  imageUrls     String[]       // Array of image URLs
  tags          String[]       // Condition tags, custom tags

  binId         String?
  bin           Bin?           @relation(fields: [binId], references: [id])

  reorderVendorId String?
  reorderVendor   Vendor?      @relation("ReorderVendor", fields: [reorderVendorId], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  transactions  InventoryTransaction[]
  stockCounts   StockCountItem[]
  serialItems   SerialItem[]
  stockLevels   StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  transferOrderItems TransferOrderItem[]
  inboundLineItems InboundLineItem[]
  brandStockMatches  BrandStockItem[]  @relation("BrandStockMatches")
  brandSkuMappings   BrandSkuMapping[] @relation("BrandSkuMappingProducts")

  @@index([status])
  @@index([categoryId])
  @@index([brandId])
  @@index([reorderVendorId])
  @@index([type])
  @@index([status, type])
  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, currentStock])
  @@index([sku])
  @@index([name])
}

// Per-location stock for a product — one row per (product, location). The source of
// truth for "how much, where". Product.currentStock is the cached SUM of these rows,
// recomputed on every change (see src/lib/stock-location.ts).
model StockLevel {
  id               String        @id @default(cuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  location         StockLocation
  quantity         Int           @default(0)
  reservedQuantity Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([productId, location])
  @@index([location])
}

model SerialItem {
  id            String        @id @default(cuid())
  serialCode    String        @unique  // Format: {SKU}-{sequence} e.g. "HRO-MTB26-0001"
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  status        SerialStatus  @default(IN_STOCK)
  condition     ProductCondition @default(NEW)

  // Location
  binId         String?
  bin           Bin?          @relation(fields: [binId], references: [id])

  // Tracking
  batchNo       String?       // Inward batch reference
  invoiceNo     String?       // Purchase invoice
  receivedAt    DateTime      @default(now())
  soldAt        DateTime?
  customerName  String?
  saleInvoiceNo String?

  // Barcode
  barcodeData   String?       // Encoded barcode string (= serialCode by default)
  barcodeFormat String        @default("CODE128") // CODE128, QR, EAN13

  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactionItems SerialTransactionItem[]

  @@index([productId])
  @@index([status])
  @@index([binId])
}

model SerialTransactionItem {
  id              String              @id @default(cuid())
  serialItemId    String
  serialItem      SerialItem          @relation(fields: [serialItemId], references: [id])
  transactionId   String
  transaction     InventoryTransaction @relation(fields: [transactionId], references: [id])
  createdAt       DateTime            @default(now())

  @@index([serialItemId])
  @@index([transactionId])
}

model Bin {
  id            String    @id @default(cuid())
  code          String    @unique  // e.g., "A-01-03" (Aisle-Rack-Shelf)
  name          String
  location      String    // "Store" or "Warehouse"
  zone          String?   // Zone within location
  capacity      Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
  serialItems   SerialItem[]
  stockCounts   StockCount[]
  transfersFrom TransferOrderItem[] @relation("TransferFromBin")
  transfersTo   TransferOrderItem[] @relation("TransferToBin")
  secondHandCycles SecondHandCycle[] @relation("SecondHandBin")
  inboundLineItems InboundLineItem[]
}

model InventoryTransaction {
  id            String           @id @default(cuid())
  type          TransactionType
  productId     String
  product       Product          @relation(fields: [productId], references: [id])
  quantity      Int
  previousStock Int
  newStock      Int

  // Reference
  referenceNo   String?          // PO number, Invoice number, etc.
  notes         String?

  // Who
  userId        String
  user          User             @relation(fields: [userId], references: [id])

  // RGP (Returnable Gate Pass)
  isRgp         Boolean          @default(false)
  rgpReturnDate DateTime?
  rgpReturned   Boolean          @default(false)

  createdAt     DateTime         @default(now())

  serialItems   SerialTransactionItem[]

  @@index([productId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([productId, type])
}

model StockCount {
  id              String           @id @default(cuid())
  countNo         String?          @unique // Auto: SC-YYYYMM-NNNN
  title           String           // "Weekly Audit - Week 15"
  assignedToId    String
  assignedTo      User             @relation(fields: [assignedToId], references: [id])
  binId           String?
  bin             Bin?             @relation(fields: [binId], references: [id])
  status          String           @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, APPROVED, REJECTED
  dueDate         DateTime
  completedAt     DateTime?
  approvedById    String?
  approvedBy      User?            @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  productType     String?          // Filter: BICYCLE, SPARE_PART, ACCESSORY, or null=all
  location        String?          // Location-level scope: "BCH-GF", "BCH-FF", etc. Null = single bin or all
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           StockCountItem[]
}

model StockCountItem {
  id              String     @id @default(cuid())
  stockCountId    String
  stockCount      StockCount @relation(fields: [stockCountId], references: [id])
  productId       String
  product         Product    @relation(fields: [productId], references: [id])
  systemQty       Int
  countedQty      Int?
  variance        Int?
  suggestedBrand  String?    // Staff suggests brand for "Imported" items
  notes           String?
  countedAt       DateTime?
}

model Vendor {
  id              String          @id @default(cuid())
  name            String          @unique
  code            String          @unique
  gstin           String?
  pan             String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  pincode         String?
  phone           String?
  email           String?
  whatsappNumber  String?
  waGroupName     String?         // Ops Issues: WhatsApp group this brand's issues are shared to
  waGroupCode     String?         // Ops Issues: human routing label for the group (e.g. "#1234")
  paymentTermDays Int             @default(30)
  creditLimit     Float           @default(0)
  cdTermsDays     Int?
  cdPercentage    Float?
  openingBalance  Float           @default(0) // As of 2026-04-01
  isActive        Boolean         @default(true)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  contacts            VendorContact[]
  purchaseOrders      PurchaseOrder[]
  bills               VendorBill[]
  payments            VendorPayment[]
  credits             VendorCredit[]
  issues              VendorIssue[]
  suggestedBankTxns   BankTransaction[] @relation("SuggestedVendorTxn")
  confirmedBankTxns   BankTransaction[] @relation("ConfirmedVendorTxn")
  reorderProducts     Product[]         @relation("ReorderVendor")

  @@index([name])
}

model VendorContact {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  name        String
  designation String?
  phone       String?
  email       String?
  whatsapp    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique
  vendorId        String
  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  status          POStatus            @default(DRAFT)
  subtotal        Float               @default(0)
  gstTotal        Float               @default(0)
  grandTotal      Float               @default(0)
  orderDate       DateTime            @default(now())
  expectedDate    DateTime?
  approvedById    String?
  approvedBy      User?               @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdById     String
  createdBy       User                @relation("POCreatedBy", fields: [createdById], references: [id])
  notes           String?
  deliveryAddress String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  items           PurchaseOrderItem[]
  bills           VendorBill[]

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Float
  gstRate         Float         @default(18)
  amount          Float
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
}

model VendorBill {
  id               String         @id @default(cuid())
  vendorId         String
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  billNo           String
  billDate         DateTime
  dueDate          DateTime
  amount           Float
  paidAmount       Float          @default(0)
  status           BillStatus     @default(PENDING)
  lastFollowedUp   DateTime?
  nextFollowUpDate DateTime?
  followUpNotes    String?
  notes            String?
  billedTo         String?        // "HUB" or "CENTRE"
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payments           VendorPayment[]
  issues             VendorIssue[]
  suggestedBankTxns  BankTransaction[] @relation("SuggestedBillTxn")
  inboundShipment    InboundShipment?

  @@unique([vendorId, billNo])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
}

model VendorPayment {
  id                String        @id @default(cuid())
  vendorId          String
  vendor            Vendor        @relation(fields: [vendorId], references: [id])
  billId            String?
  bill              VendorBill?   @relation(fields: [billId], references: [id])
  amount            Float
  cdDiscountAmount  Float         @default(0) // Cash discount applied
  paymentMode       PaymentMode
  paymentDate       DateTime
  referenceNo       String?
  notes             String?
  creditId          String?
  credit            VendorCredit? @relation(fields: [creditId], references: [id])
  recordedById      String
  recordedBy        User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt         DateTime      @default(now())

  @@index([vendorId])
  @@index([billId])
  @@index([paymentDate])
}

model VendorCredit {
  id            String          @id @default(cuid())
  vendorId      String
  vendor        Vendor          @relation(fields: [vendorId], references: [id])
  creditNoteNo  String
  amount        Float
  usedAmount    Float           @default(0)
  reason        String?
  creditDate    DateTime
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  payments      VendorPayment[]

  @@unique([vendorId, creditNoteNo])
  @@index([vendorId])
}

model Expense {
  id            String          @id @default(cuid())
  date          DateTime
  amount        Float
  category      ExpenseCategory
  description   String
  paidBy        String
  paymentMode   PaymentMode
  referenceNo   String?
  receiptUrl    String?
  notes         String?
  recordedById  String
  recordedBy    User            @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([recordedById])
}

// ─── BANK STATEMENT RECONCILIATION ───

enum BankTxnType {
  CREDIT
  DEBIT
}

enum BankTxnMatchStatus {
  UNMATCHED
  MATCHED
  FLAGGED
  EXPENSE
  IGNORED
}

model BankStatement {
  id              String            @id @default(cuid())
  bank            String            // HDFC, ICICI
  accountNumber   String?
  fileName        String
  fromDate        DateTime?
  toDate          DateTime?
  totalCredits    Float             @default(0)
  totalDebits     Float             @default(0)
  txnCount        Int               @default(0)
  matchedCount    Int               @default(0)
  flaggedCount    Int               @default(0)
  uploadedById    String
  uploadedBy      User              @relation("StatementUploader", fields: [uploadedById], references: [id])
  createdAt       DateTime          @default(now())

  transactions    BankTransaction[]

  @@index([createdAt])
}

model BankTransaction {
  id              String              @id @default(cuid())
  statementId     String
  statement       BankStatement       @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date            DateTime
  description     String
  reference       String?
  amount          Float
  type            BankTxnType         // CREDIT or DEBIT
  balance         Float?
  matchStatus     BankTxnMatchStatus  @default(UNMATCHED)
  flagReason      String?
  // AI-suggested matches
  suggestedVendorId   String?
  suggestedVendor     Vendor?         @relation("SuggestedVendorTxn", fields: [suggestedVendorId], references: [id])
  suggestedBillId     String?
  suggestedBill       VendorBill?     @relation("SuggestedBillTxn", fields: [suggestedBillId], references: [id])
  suggestedCategory   String?         // For expenses
  confidence          Float?          // AI match confidence 0-1
  // Confirmed matches
  confirmedVendorId   String?
  confirmedVendor     Vendor?         @relation("ConfirmedVendorTxn", fields: [confirmedVendorId], references: [id])
  confirmedPaymentId  String?
  confirmedExpenseId  String?
  processedAt         DateTime?
  createdAt           DateTime        @default(now())

  settlementMatches   SettlementMatch[]

  @@index([statementId])
  @@index([matchStatus])
  @@index([date])
}

model ZohoConfig {
  id                   String    @id @default("singleton")
  clientId             String?
  clientSecret         String?
  refreshToken         String?
  accessToken          String?
  accessTokenExpiresAt DateTime?
  organizationId       String?
  organizationName     String?
  isConnected          Boolean   @default(false)
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ZakyaConfig {
  id                   String    @id @default("singleton")
  clientId             String?
  clientSecret         String?
  refreshToken         String?
  accessToken          String?
  accessTokenExpiresAt DateTime?
  organizationId       String?
  organizationName     String?
  isConnected          Boolean   @default(false)
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ZohoInventoryConfig {
  id                   String    @id @default("singleton")
  clientId             String?
  clientSecret         String?
  refreshToken         String?
  accessToken          String?
  accessTokenExpiresAt DateTime?
  organizationId       String?
  organizationName     String?
  isConnected          Boolean   @default(false)
  lastSyncAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model SyncLog {
  id          String   @id @default(cuid())
  syncType    String   // items, contacts, invoices, bills, all
  status      String   // running, success, partial, failed
  totalItems  Int      @default(0)
  synced      Int      @default(0)
  failed      Int      @default(0)
  errors      String?  // JSON array of error messages
  startedAt   DateTime @default(now())
  completedAt DateTime?
  triggeredBy String?  // userId

  @@index([syncType])
  @@index([startedAt])
}

// ---- Customers & Receivables ----

model Customer {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  type          CustomerType   @default(WALK_IN)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  invoices      CustomerInvoice[]
  payments      CustomerPayment[]

  @@index([name])
  @@index([phone])
}

model CustomerInvoice {
  id            String         @id @default(cuid())
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  invoiceNo     String         @unique
  invoiceDate   DateTime
  dueDate       DateTime
  amount        Float
  paidAmount    Float          @default(0)
  status        InvoiceStatus  @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  payments      CustomerPayment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model CustomerPayment {
  id            String           @id @default(cuid())
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  invoiceId     String?
  invoice       CustomerInvoice? @relation(fields: [invoiceId], references: [id])
  amount        Float
  paymentMode   PaymentMode
  paymentDate   DateTime
  referenceNo   String?
  notes         String?
  recordedById  String
  recordedBy    User             @relation("CustomerPaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@index([paymentDate])
}

// ---- Vendor Issues ----

model VendorIssue {
  id            String         @id @default(cuid())
  issueSource   IssueSource    @default(VENDOR)
  vendorId      String?
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  clientName    String?
  clientPhone   String?
  issueNo       String         @unique // ISS-YYYYMM-NNNN
  ticketNo      String?        // Brand's own ticket/reference number (e.g. eMotorad) — shown in the WhatsApp message
  issueType     IssueType
  description   String
  status        IssueStatus    @default(OPEN)
  priority      IssuePriority  @default(MEDIUM)
  billId        String?
  bill          VendorBill?    @relation(fields: [billId], references: [id])
  photoUrls           String[]
  docLink             String?           // optional supporting document/spreadsheet link for the brand to verify
  suggestedResolution String?
  resolution    String?
  resolvedAt    DateTime?
  createdById   String
  createdBy     User           @relation("IssueCreatedBy", fields: [createdById], references: [id])
  notes         VendorIssueNote[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([issueSource])
}

// Append-only follow-up log on an issue — Hamsa/Suma add a timestamped note each time they chase
// the brand, so the full follow-up history (and stage progress) is tracked, not just one resolution.
model VendorIssueNote {
  id        String      @id @default(cuid())
  issueId   String
  issue     VendorIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  text      String
  authorId  String
  author    User        @relation("IssueNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([issueId])
}

enum IssueSource {
  VENDOR
  CLIENT
}

enum DeliveryStatus {
  PENDING
  VERIFIED
  WALK_OUT
  SCHEDULED
  OUT_FOR_DELIVERY
  DELIVERED
  FLAGGED
  PREBOOKED
  PACKED
  SHIPPED
  IN_TRANSIT
}

model Delivery {
  id              String          @id @default(cuid())
  invoiceNo       String          @unique
  zohoInvoiceId   String?
  invoiceDate     DateTime
  invoiceAmount   Float

  customerName    String
  customerPhone   String?
  alternatePhone  String?
  customerAddress String?
  customerArea    String?
  customerPincode String?

  status          DeliveryStatus  @default(PENDING)
  verifiedAt      DateTime?
  verifiedById    String?
  verifiedBy      User?           @relation("DeliveryVerifiedBy", fields: [verifiedById], references: [id])

  scheduledDate   DateTime?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  stockReservedAt DateTime?

  expectedReadyDate DateTime?
  prebookNotes    String?

  flagReason      String?
  flaggedAt       DateTime?
  flagResolvedAt  DateTime?
  flagResolvedBy  String?

  invoiceType     String?           // "SALES" | "SERVICE" — null = not yet tagged
  salesPerson     String?
  lineItems       Json?
  notes           String?
  deliveryNotes   String?

  // WhatsApp tracking
  whatsAppScheduledSent   Boolean  @default(false)
  whatsAppDispatchedSent  Boolean  @default(false)
  whatsAppDeliveredSent   Boolean  @default(false)
  freeAccessories         String?

  reversePickup           Boolean  @default(false)

  // Outstation delivery
  isOutstation            Boolean  @default(false)
  courierName             String?
  courierTrackingNo       String?
  courierTrackingLink     String?
  courierCost             Float?
  vehicleNo               String?

  // Customer self-fill
  selfFillToken       String?   @unique
  selfFillTokenExpiry DateTime?
  selfFillCompletedAt DateTime?
  mapsLink            String?   // Google Maps location link shared by customer

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([invoiceDate])
  @@index([customerArea])
  @@index([scheduledDate])
}

model AlertConfig {
  id              String   @id @default("singleton")
  redFlagPhones   String?
  googleReviewLink String?
  whatsappTemplates Json?    // { scheduled, dispatched, delivered } message templates
  rolePermissions Json?      // { ROLE: { feature: { view, edit, delete, approve } } }
  updatedAt       DateTime @updatedAt
}

// ─── Zoho Pull Preview (approval gate) ───────────────────────

model ZohoPullPreview {
  id            String    @id @default(cuid())
  pullId        String
  entityType    String    // "contact", "item", "bill", "invoice"
  action        String    @default("new")
  zohoId        String
  data          Json
  localMatch    Json?
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime  @default(now())

  @@index([pullId])
  @@index([entityType])
  @@index([status])
}

model ZohoPullLog {
  id              String    @id @default(cuid())
  pullId          String    @unique
  status          String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED, PARTIAL
  contactsNew     Int       @default(0)
  itemsNew        Int       @default(0)
  billsNew        Int       @default(0)
  invoicesNew     Int       @default(0)
  errors          String?
  apiCallsUsed    Int       @default(0)
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?

  @@index([status])
  @@index([createdAt])
}

// ─── Second-Hand Cycles (Exchange inventory) ───────────────────────

model SecondHandCycle {
  id              String    @id @default(cuid())
  sku             String    @unique  // Auto: SH-0001
  name            String               // e.g., "Hero Sprint 26"
  size            String?              // e.g., "26", "24", "20" (wheel size in inches)
  condition       String               // EXCELLENT, GOOD, FAIR, SCRAP
  status          String    @default("IN_STOCK") // IN_STOCK, SOLD
  costPrice       Float               // Exchange price
  sellingPrice    Float?              // Set by admin after service
  photoUrl        String              // Primary image URL (thumbnail)
  photoUrls       String[]            // All image URLs including primary

  // Source (who traded in)
  customerName    String
  customerPhone   String?
  zohoInvoiceNo   String?             // New cycle sale invoice
  zohoItemId      String?             // Zoho Inventory item_id after push

  // Location
  binId           String?
  bin             Bin?      @relation("SecondHandBin", fields: [binId], references: [id])

  // Sale details
  soldAt          DateTime?
  soldToName      String?
  soldToPhone     String?
  soldInvoiceNo   String?

  notes           String?
  isArchived      Boolean   @default(false)

  // Verification
  isVerified      Boolean   @default(false)
  verifiedById    String?
  verifiedBy      User?     @relation("SecondHandVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt      DateTime?

  createdById     String
  createdBy       User      @relation("SecondHandCreatedBy", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([sku])
  @@index([createdAt])
  @@index([isVerified])
}

// ─── Transfer Orders (Multi-item bin transfers) ───────────────────────

enum TransferOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TransferOrder {
  id            String              @id @default(cuid())
  orderNo       String              @unique // Auto: TRF-YYYYMM-NNNN
  status        TransferOrderStatus @default(PENDING)
  notes         String?

  createdById   String
  createdBy     User                @relation("TransferCreatedBy", fields: [createdById], references: [id])
  reviewedById  String?
  reviewedBy    User?               @relation("TransferReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  rejectionNote String?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         TransferOrderItem[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
}

model TransferOrderItem {
  id              String        @id @default(cuid())
  transferOrderId String
  transferOrder   TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  // Bin mode (dormant): source/destination bins. Location mode (active): fromLocation/toLocation.
  fromBinId       String?
  fromBin         Bin?          @relation("TransferFromBin", fields: [fromBinId], references: [id])
  toBinId         String?
  toBin           Bin?          @relation("TransferToBin", fields: [toBinId], references: [id])
  fromLocation    StockLocation?
  toLocation      StockLocation?
  createdAt       DateTime      @default(now())

  @@index([transferOrderId])
  @@index([productId])
}

// ─── Inbound Tracking (Brand Deliveries & Pre-booking) ───────────────────────

model BrandLeadTime {
  id        String   @id @default(cuid())
  brandId   String   @unique
  brand     Brand    @relation(fields: [brandId], references: [id])
  leadDays  Int      @default(7)
  updatedAt DateTime @updatedAt
}

enum InboundShipmentStatus {
  IN_TRANSIT
  DELIVERED
  PARTIALLY_DELIVERED
}

model InboundShipment {
  id                    String                @id @default(cuid())
  shipmentNo            String                @unique // Auto: IB-YYYYMM-0001
  brandId               String
  brand                 Brand                 @relation(fields: [brandId], references: [id])
  billNo                String                // Brand's invoice number (from image)
  billImageUrl          String?               @db.Text // Base64 photo of paper bill (optional for Zoho bills)
  billPdfUrl            String?               // Supabase Storage URL for uploaded PDF
  billDate              DateTime
  expectedDeliveryDate  DateTime
  status                InboundShipmentStatus @default(IN_TRANSIT)
  totalAmount           Float
  totalItems            Int
  approvedAt            DateTime?
  approvedById          String?
  approvedBy            User?                 @relation("InboundApprovedBy", fields: [approvedById], references: [id])
  deliveredAt           DateTime?
  deliveredById         String?
  deliveredBy           User?                 @relation("InboundDeliveredBy", fields: [deliveredById], references: [id])
  putawayAt             DateTime?
  putawayById           String?
  putawayBy             User?                 @relation("InboundPutawayBy", fields: [putawayById], references: [id])
  notes                 String?
  createdById           String
  createdBy             User                  @relation("InboundCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  vendorBillId          String?               @unique
  vendorBill            VendorBill?           @relation(fields: [vendorBillId], references: [id])
  zohoBillId            String?               // Zoho Books bill_id

  lineItems             InboundLineItem[]
  preBookings           PreBooking[]

  @@index([status])
  @@index([brandId])
  @@index([billNo])
  @@index([expectedDeliveryDate])
  @@index([createdAt])
}

model InboundLineItem {
  id                     String            @id @default(cuid())
  shipmentId             String
  shipment               InboundShipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  productName            String            // As read from bill image
  productId              String?           // Matched to existing product
  product                Product?          @relation(fields: [productId], references: [id])
  sku                    String?
  quantity               Int
  rate                   Float
  gstPercent             Float             @default(0)
  gstAmount              Float             @default(0)
  amount                 Float
  hsn                    String?
  isDelivered            Boolean           @default(false)
  deliveredQty           Int?
  preBookedCustomerName  String?
  preBookedCustomerPhone String?
  preBookedInvoiceNo     String?
  whatsAppSent           Boolean           @default(false)
  notes                  String?

  binId                  String?
  bin                    Bin?              @relation(fields: [binId], references: [id])

  preBooking             PreBooking?       @relation("PreBookingLineItem")

  @@index([shipmentId])
  @@index([productId])
}

// ─── POS Daily Settlement ───────────────────────

enum SettlementStatus {
  PENDING
  CASH_VERIFIED
  PARTIALLY_MATCHED
  FULLY_MATCHED
  DISCREPANCY
}

model PosSession {
  id                String    @id @default(cuid())
  zakyaSessionId    String    @unique
  sessionDate       DateTime
  openedAt          DateTime
  closedAt          DateTime?
  registerName      String?
  cashierName       String?

  // Payment mode totals from POS
  cashSales         Float     @default(0)
  cardSales         Float     @default(0)
  upiSales          Float     @default(0)
  financeSales      Float     @default(0)  // Bajaj EMI etc.
  totalSales        Float     @default(0)

  // Cash drawer
  cashIn            Float     @default(0)  // Cash received (non-sales)
  cashOut           Float     @default(0)  // Cash withdrawn from drawer
  cashRefunds       Float     @default(0)
  expectedCash      Float     @default(0)  // Expected cash at session end
  countedCash       Float?                 // Actual cash counted at close
  cashDiscrepancy   Float     @default(0)  // countedCash - expectedCash

  // Credit & other
  creditSales       Float     @default(0)  // Credit sale / unpaid invoices
  cashInHand        Float     @default(0)  // Opening + cash sales - cash out
  cashDeposited     Float     @default(0)  // Amount deposited to bank

  invoiceCount      Int       @default(0)
  rawData           Json?     // Full Zakya session response

  settlementId      String?
  settlement        DailySettlement? @relation(fields: [settlementId], references: [id])

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([sessionDate])
  @@index([settlementId])
}

model DailySettlement {
  id                String            @id @default(cuid())
  date              DateTime          @unique  // One settlement per day
  status            SettlementStatus  @default(PENDING)

  // Totals from POS sessions
  totalCash         Float             @default(0)
  totalCard         Float             @default(0)
  totalUpi          Float             @default(0)
  totalFinance      Float             @default(0)
  totalCredit       Float             @default(0)  // Credit sales
  grandTotal        Float             @default(0)

  // Cash verification
  cashCounted       Float?            // Physical cash count by staff
  cashVariance      Float?            // cashCounted - totalCash
  cashVerifiedAt    DateTime?
  cashVerifiedById  String?
  cashVerifiedBy    User?             @relation("SettlementCashVerifier", fields: [cashVerifiedById], references: [id])

  // Cash drawer — manual daily entry
  cashIn            Float             @default(0)  // Cash received into drawer
  cashOut           Float             @default(0)  // Cash taken out (must be linked to expense)
  cashOutReason     String?           // Reason for cash out

  // Bank matching
  matchedAmount     Float             @default(0)
  unmatchedAmount   Float             @default(0)
  notes             String?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sessions          PosSession[]
  matches           SettlementMatch[]

  @@index([status])
  @@index([date])
}

model SettlementMatch {
  id                String          @id @default(cuid())
  settlementId      String
  settlement        DailySettlement @relation(fields: [settlementId], references: [id])
  paymentMode       String          // CARD, UPI, FINANCE, CASH_DEPOSIT
  expectedAmount    Float           // From POS
  bankTxnId         String?
  bankTxn           BankTransaction? @relation(fields: [bankTxnId], references: [id])
  matchedAmount     Float           @default(0)
  variance          Float           @default(0)
  isMatched         Boolean         @default(false)
  notes             String?
  createdAt         DateTime        @default(now())

  @@index([settlementId])
  @@index([bankTxnId])
}

enum PreBookingStatus {
  WAITING
  MATCHED
  FULFILLED
  CANCELLED
}

model PreBooking {
  id                    String            @id @default(cuid())
  customerName          String
  customerPhone         String?
  zohoInvoiceNo         String
  productName           String            // What cycle they booked
  brandId               String?
  brand                 Brand?            @relation(fields: [brandId], references: [id])
  status                PreBookingStatus  @default(WAITING)
  matchedShipmentId     String?
  matchedShipment       InboundShipment?  @relation(fields: [matchedShipmentId], references: [id])
  matchedLineItemId     String?           @unique
  matchedLineItem       InboundLineItem?  @relation("PreBookingLineItem", fields: [matchedLineItemId], references: [id])
  salesPerson           String?
  expectedDate          DateTime?
  fulfilledAt           DateTime?
  createdById           String
  createdBy             User              @relation("PreBookingCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([status])
  @@index([brandId])
  @@index([matchedShipmentId])
  @@index([createdAt])
}

model StoreUpdate {
  id        String   @id @default(cuid())
  text      String   @db.Text
  category  String
  userId    String
  user      User     @relation("UpdatePostedBy", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model OpsActivityLog {
  id        String   @id @default(cuid())
  action    String
  details   String   @db.Text
  userId    String
  user      User     @relation("OpsActivityLoggedBy", fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model DailySnapshot {
  id          String   @id @default("latest")
  markdown    String   @db.Text
  generatedAt DateTime @default(now())
}

model AppProblem {
  id          String   @id @default(cuid())
  text        String   @db.Text
  category    String   @default("general")
  status      String   @default("open")
  userId      String
  user        User     @relation("ProblemReportedBy", fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// ─── Brand Stock Upload + Smart Reorder ───────────

enum BrandStockUploadStatus {
  PROCESSING
  PARSED
  REVIEWED
  FAILED
}

enum BrandStockMatchStatus {
  AUTO_MATCHED
  FUZZY_MATCHED
  MANUAL_MATCHED
  UNMATCHED
}

model BrandStockUpload {
  id             String                  @id @default(cuid())
  brandId        String
  brand          Brand                   @relation("BrandStockUploads", fields: [brandId], references: [id])
  fileName       String
  fileType       String
  status         BrandStockUploadStatus  @default(PROCESSING)
  totalItems     Int                     @default(0)
  matchedItems   Int                     @default(0)
  unmatchedItems Int                     @default(0)
  notes          String?
  uploadedById   String
  uploadedBy     User                    @relation("BrandStockUploadedBy", fields: [uploadedById], references: [id])
  items          BrandStockItem[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([createdAt])
}

model BrandStockItem {
  id                String                @id @default(cuid())
  uploadId          String
  upload            BrandStockUpload      @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  rawSku            String?
  rawName           String
  rawCategory       String?
  brandAvailableQty Int                   @default(0)
  brandPrice        Float?
  brandMrp          Float?
  rawSize           String?
  matchStatus       BrandStockMatchStatus @default(UNMATCHED)
  matchConfidence   Float?
  productId         String?
  product           Product?              @relation("BrandStockMatches", fields: [productId], references: [id])
  bchCurrentStock   Int?
  bchReorderLevel   Int?
  suggestedQty      Int?
  orderQty          Int?
  selected          Boolean               @default(false)
  createdAt         DateTime              @default(now())

  @@index([uploadId])
  @@index([matchStatus])
  @@index([productId])
}

model BrandSkuMapping {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation("BrandSkuMappings", fields: [brandId], references: [id])
  brandSku   String?
  brandName  String
  productId  String
  product    Product  @relation("BrandSkuMappingProducts", fields: [productId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([brandId, brandName])
  @@index([brandId])
  @@index([productId])
}

