generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── RBAC ────────────────────────────────────────────────────
// Roles, modules and permissions are DATA, not code. The former `enum Role` and the
// hardcoded permission maps in src/lib/permissions-server.ts have been replaced by the
// Module / Permission / Role / RolePermission tables below, so access can be changed at
// runtime without a redeploy.
//
//   Module  1──*  Permission  *──*  Role  1──*  User
//                        └── RolePermission ──┘
//
// A module is a functional area ("stock"). A permission is one action on one module
// ("stock.edit"). A role holds any number of permissions. A user has exactly one role.

model Module {
  id          String   @id @default(cuid())
  key         String   @unique // stable identifier used in code: "stock", "inbound"
  label       String // human label shown in the sidebar and the admin editor
  description String?
  icon        String? // lucide icon name, resolved client-side
  route       String? // primary route, used to build the sidebar
  group       String? // sidebar grouping: "Accounts", "Purchase", "Operations", "Admin"
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]

  @@index([isActive, sortOrder])
  @@map("modules")
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // "stock.edit" — module.key + "." + action
  moduleId    String
  action      String // view | create | edit | delete | approve | fetch
  label       String
  description String?
  createdAt   DateTime @default(now())

  module Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  roles  RolePermission[]

  @@unique([moduleId, action]) // one row per module+action
  @@index([moduleId])
  @@map("permissions")
}

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // "ADMIN" — stable identifier
  name        String // "Administrator" — editable display name
  description String?
  isSystem    Boolean  @default(false) // system roles cannot be deleted or renamed
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@index([isActive])
  @@map("roles")
}

// Join table carrying the grants. A row's existence IS the grant — there is no
// boolean column, so revoking is a delete and the table never holds "false" noise.
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

enum TransactionType {
  INWARD
  OUTWARD
  TRANSFER
  ADJUSTMENT
}

enum SerialStatus {
  IN_STOCK
  SOLD
  RETURNED
  DAMAGED
  RGP_OUT
  TRANSFERRED
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT_TO_VENDOR
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum BillStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  DISPUTED
}

enum PaymentMode {
  CASH
  CHEQUE
  NEFT
  RTGS
  UPI
  CREDIT_ADJUSTMENT
}

enum ExpenseCategory {
  DELIVERY
  TRANSPORT
  SHOP_MAINTENANCE
  UTILITIES
  SALARY_ADVANCE
  FOOD_TEA
  STATIONERY
  MISCELLANEOUS
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum CustomerType {
  WALK_IN
  REGULAR
  DEALER
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum IssueType {
  QUALITY
  SHORTAGE
  DAMAGE
  WRONG_ITEM
  BILLING_ERROR
  DELIVERY_DELAY
  OTHER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProductCondition {
  NEW
  REFURBISHED_EXCELLENT
  REFURBISHED_GOOD
  REFURBISHED_FAIR
  DAMAGED
}

enum ProductType {
  BICYCLE
  SPARE_PART
  ACCESSORY
  BOX_PIECE
  WIP
  FINISHED_GOOD
}

// Active stock-tracking locations. Bins (see Bin model) are dormant; per-location
// quantity lives in StockLevel keyed by this enum. Two sites (BCH, BCC), each with
// a warehouse and a store. STORE/WAREHOUSE are legacy values kept only so old rows
// migrate cleanly — they are no longer used by the app.
enum StockLocation {
  STORE
  WAREHOUSE
  BCH_WAREHOUSE
  BCH_STORE
  BCC_WAREHOUSE
  BCC_STORE
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  accessCode String   @unique
  isActive   Boolean  @default(true)
  // Avatar shown beside a mechanic's name across the workshop screens. Display only —
  // carried over from the service app's User because its UI leans on it heavily. The
  // service app's `pin` column was NOT carried over: there is one login, and it is the
  // inventory access code.
  emoji      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  transactions InventoryTransaction[]
  stockCounts  StockCount[]

  createdPOs               PurchaseOrder[]   @relation("POCreatedBy")
  approvedPOs              PurchaseOrder[]   @relation("POApprovedBy")
  recordedPayments         VendorPayment[]   @relation("PaymentRecordedBy")
  recordedExpenses         Expense[]         @relation("ExpenseRecordedBy")
  recordedCustomerPayments CustomerPayment[] @relation("CustomerPaymentRecordedBy")
  createdIssues            VendorIssue[]     @relation("IssueCreatedBy")
  issueNotes               VendorIssueNote[] @relation("IssueNoteAuthor")
  navTabs                  String[]          @default([]) // admin-chosen bottom-nav hrefs (empty = role default)
  approvedStockCounts      StockCount[]      @relation("StockCountApprovedBy")
  verifiedDeliveries       Delivery[]        @relation("DeliveryVerifiedBy")
  uploadedStatements       BankStatement[]   @relation("StatementUploader")

  // Service / workshop (merged from bch-service)
  assignedJobs       ServiceJob[]     @relation("ServiceJobMechanic")
  createdServiceJobs ServiceJob[]     @relation("ServiceJobCreatedBy")
  serviceReviews     Review[]         @relation("ServiceReviewMechanic")
  taskAssignments    TaskAssignment[] @relation("TaskAssignmentMechanic")
  assemblyLogs       AssemblyLog[]    @relation("AssemblyMechanic")

  // Transfer orders
  createdTransfers  TransferOrder[] @relation("TransferCreatedBy")
  reviewedTransfers TransferOrder[] @relation("TransferReviewedBy")

  // Second-hand cycles
  createdSecondHand  SecondHandCycle[] @relation("SecondHandCreatedBy")
  verifiedSecondHand SecondHandCycle[] @relation("SecondHandVerifiedBy")

  // Inbound shipments
  createdInboundShipments   InboundShipment[] @relation("InboundCreatedBy")
  approvedInboundShipments  InboundShipment[] @relation("InboundApprovedBy")
  deliveredInboundShipments InboundShipment[] @relation("InboundDeliveredBy")
  putawayInboundShipments   InboundShipment[] @relation("InboundPutawayBy")

  // Pre-bookings
  createdPreBookings PreBooking[] @relation("PreBookingCreatedBy")

  // POS settlements
  verifiedSettlements DailySettlement[] @relation("SettlementCashVerifier")

  // Operations Hub (Tasks, SOPs, Updates)
  postedUpdates     StoreUpdate[]      @relation("UpdatePostedBy")
  opsActivityLogs   OpsActivityLog[]   @relation("OpsActivityLoggedBy")
  brandStockUploads BrandStockUpload[] @relation("BrandStockUploadedBy")
  reportedProblems  AppProblem[]       @relation("ProblemReportedBy")

  // Brand ledger reconciliation
  importedStatements   BrandStatement[]     @relation("StatementImportedBy")
  createdLedgerGaps    LedgerGap[]          @relation("LedgerGapCreatedBy")
  ledgerGapNotes       LedgerGapNote[]      @relation("LedgerGapNoteAuthor")
  uploadedGapEvidence  LedgerGapEvidence[]  @relation("GapEvidenceUploadedBy")
  createdDiscountTerms VendorDiscountTerm[] @relation("DiscountTermCreatedBy")

  @@index([roleId])
}

model Category {
  id           String     @id @default(cuid())
  name         String     @unique
  description  String?
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  movingLevel  String     @default("NORMAL") // FAST, NORMAL, SLOW
  reorderLevel Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  products Product[]
}

model Brand {
  id             String   @id @default(cuid())
  name           String   @unique
  contactName    String?
  contactPhone   String?
  whatsappNumber String?
  cdTermsDays    Int? // Cash Discount terms in days
  cdPercentage   Float? // Cash Discount percentage
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products         Product[]
  leadTime         BrandLeadTime?
  inboundShipments InboundShipment[]
  preBookings      PreBooking[]
  stockUploads     BrandStockUpload[] @relation("BrandStockUploads")
  skuMappings      BrandSkuMapping[]  @relation("BrandSkuMappings")

  // Brand ledger reconciliation. cdTermsDays/cdPercentage above are DEAD — every one of the
  // 50 cash-discount usages in src/ reads Vendor, not Brand. Agreed terms live in
  // VendorDiscountTerm; drop the two columns in a later cleanup.
  ledgerEntries BrandLedgerEntry[]   @relation("BrandLedgerEntries")
  ledgerGaps    LedgerGap[]          @relation("BrandLedgerGaps")
  discountTerms VendorDiscountTerm[] @relation("BrandDiscountTerms")
  vendors       BrandVendor[]        @relation("BrandVendors")
}

model Product {
  id          String           @id @default(cuid())
  sku         String           @unique
  name        String
  description String?
  zohoItemId  String?          @unique // Zoho Books item_id for sync
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id])
  brandId     String
  brand       Brand            @relation(fields: [brandId], references: [id])
  type        ProductType      @default(SPARE_PART)
  status      ProductStatus    @default(ACTIVE)
  condition   ProductCondition @default(NEW)

  // Pricing
  costPrice    Float   @default(0)
  sellingPrice Float   @default(0)
  mrp          Float   @default(0)
  gstRate      Float   @default(18)
  hsnCode      String?

  // Stock
  currentStock  Int @default(0)
  reservedStock Int @default(0)
  minStock      Int @default(0)
  maxStock      Int @default(0)
  reorderLevel  Int @default(0)
  reorderQty    Int @default(0)

  // Bicycle specific
  size      String? // For bicycles: 16", 20", 24", 26", etc.
  color     String?
  imageUrls String[] // Array of image URLs
  tags      String[] // Condition tags, custom tags

  binId String?
  bin   Bin?    @relation(fields: [binId], references: [id])

  reorderVendorId String?
  reorderVendor   Vendor? @relation("ReorderVendor", fields: [reorderVendorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions       InventoryTransaction[]
  stockCounts        StockCountItem[]
  serialItems        SerialItem[]
  stockLevels        StockLevel[]
  purchaseOrderItems PurchaseOrderItem[]
  transferOrderItems TransferOrderItem[]
  inboundLineItems   InboundLineItem[]
  brandStockMatches  BrandStockItem[]       @relation("BrandStockMatches")
  brandSkuMappings   BrandSkuMapping[]      @relation("BrandSkuMappingProducts")

  @@index([status])
  @@index([categoryId])
  @@index([brandId])
  @@index([reorderVendorId])
  @@index([type])
  @@index([status, type])
  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, currentStock])
  @@index([sku])
  @@index([name])
}

// Per-location stock for a product — one row per (product, location). The source of
// truth for "how much, where". Product.currentStock is the cached SUM of these rows,
// recomputed on every change (see src/lib/stock-location.ts).
model StockLevel {
  id               String        @id @default(cuid())
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  location         StockLocation
  quantity         Int           @default(0)
  reservedQuantity Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([productId, location])
  @@index([location])
}

model SerialItem {
  id         String           @id @default(cuid())
  serialCode String           @unique // Format: {SKU}-{sequence} e.g. "HRO-MTB26-0001"
  productId  String
  product    Product          @relation(fields: [productId], references: [id])
  status     SerialStatus     @default(IN_STOCK)
  condition  ProductCondition @default(NEW)

  // Location
  binId String?
  bin   Bin?    @relation(fields: [binId], references: [id])

  // Tracking
  batchNo       String? // Inward batch reference
  invoiceNo     String? // Purchase invoice
  receivedAt    DateTime  @default(now())
  soldAt        DateTime?
  customerName  String?
  saleInvoiceNo String?

  // Barcode
  barcodeData   String? // Encoded barcode string (= serialCode by default)
  barcodeFormat String  @default("CODE128") // CODE128, QR, EAN13

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionItems SerialTransactionItem[]

  @@index([productId])
  @@index([status])
  @@index([binId])
}

model SerialTransactionItem {
  id            String               @id @default(cuid())
  serialItemId  String
  serialItem    SerialItem           @relation(fields: [serialItemId], references: [id])
  transactionId String
  transaction   InventoryTransaction @relation(fields: [transactionId], references: [id])
  createdAt     DateTime             @default(now())

  @@index([serialItemId])
  @@index([transactionId])
}

model Bin {
  id        String   @id @default(cuid())
  code      String   @unique // e.g., "A-01-03" (Aisle-Rack-Shelf)
  name      String
  location  String // "Store" or "Warehouse"
  zone      String? // Zone within location
  capacity  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products         Product[]
  serialItems      SerialItem[]
  stockCounts      StockCount[]
  transfersFrom    TransferOrderItem[] @relation("TransferFromBin")
  transfersTo      TransferOrderItem[] @relation("TransferToBin")
  secondHandCycles SecondHandCycle[]   @relation("SecondHandBin")
  inboundLineItems InboundLineItem[]
}

model InventoryTransaction {
  id            String          @id @default(cuid())
  type          TransactionType
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  quantity      Int
  previousStock Int
  newStock      Int

  // Reference
  referenceNo String? // PO number, Invoice number, etc.
  notes       String?

  // Who
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // RGP (Returnable Gate Pass)
  isRgp         Boolean   @default(false)
  rgpReturnDate DateTime?
  rgpReturned   Boolean   @default(false)

  createdAt DateTime @default(now())

  serialItems SerialTransactionItem[]

  @@index([productId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([type, createdAt])
  @@index([productId, type])
}

model StockCount {
  id              String    @id @default(cuid())
  countNo         String?   @unique // Auto: SC-YYYYMM-NNNN
  title           String // "Weekly Audit - Week 15"
  assignedToId    String
  assignedTo      User      @relation(fields: [assignedToId], references: [id])
  binId           String?
  bin             Bin?      @relation(fields: [binId], references: [id])
  status          String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, APPROVED, REJECTED
  dueDate         DateTime
  completedAt     DateTime?
  approvedById    String?
  approvedBy      User?     @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectionReason String?
  notes           String?
  productType     String? // Filter: BICYCLE, SPARE_PART, ACCESSORY, or null=all
  location        String? // Location-level scope: "BCH-GF", "BCH-FF", etc. Null = single bin or all
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items StockCountItem[]
}

model StockCountItem {
  id             String     @id @default(cuid())
  stockCountId   String
  stockCount     StockCount @relation(fields: [stockCountId], references: [id])
  productId      String
  product        Product    @relation(fields: [productId], references: [id])
  systemQty      Int
  countedQty     Int?
  variance       Int?
  suggestedBrand String? // Staff suggests brand for "Imported" items
  notes          String?
  countedAt      DateTime?
}

model Vendor {
  id              String   @id @default(cuid())
  name            String   @unique
  code            String   @unique
  gstin           String?
  pan             String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  pincode         String?
  phone           String?
  email           String?
  whatsappNumber  String?
  waGroupName     String? // Ops Issues: WhatsApp group this brand's issues are shared to
  waGroupCode     String? // Ops Issues: human routing label for the group (e.g. "#1234")
  paymentTermDays Int      @default(30)
  creditLimit     Float    @default(0)
  cdTermsDays     Int?
  cdPercentage    Float?
  openingBalance  Float    @default(0) // As of 2026-04-01
  isActive        Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts          VendorContact[]
  purchaseOrders    PurchaseOrder[]
  bills             VendorBill[]
  payments          VendorPayment[]
  credits           VendorCredit[]
  issues            VendorIssue[]
  suggestedBankTxns BankTransaction[] @relation("SuggestedVendorTxn")
  confirmedBankTxns BankTransaction[] @relation("ConfirmedVendorTxn")
  reorderProducts   Product[]         @relation("ReorderVendor")

  // Brand ledger reconciliation
  ledgerEntries BrandLedgerEntry[]
  statements    BrandStatement[]
  ledgerGaps    LedgerGap[]
  discountTerms VendorDiscountTerm[]
  brands        BrandVendor[]        @relation("VendorBrands")

  @@index([name])
}

model VendorContact {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id])
  name        String
  designation String?
  phone       String?
  email       String?
  whatsapp    String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId])
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  poNumber        String    @unique
  vendorId        String
  vendor          Vendor    @relation(fields: [vendorId], references: [id])
  status          POStatus  @default(DRAFT)
  subtotal        Float     @default(0)
  gstTotal        Float     @default(0)
  grandTotal      Float     @default(0)
  orderDate       DateTime  @default(now())
  expectedDate    DateTime?
  approvedById    String?
  approvedBy      User?     @relation("POApprovedBy", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  createdById     String
  createdBy       User      @relation("POCreatedBy", fields: [createdById], references: [id])
  notes           String?
  deliveryAddress String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items PurchaseOrderItem[]
  bills VendorBill[]

  @@index([vendorId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Int
  receivedQty     Int           @default(0)
  unitPrice       Float
  gstRate         Float         @default(18)
  amount          Float
  createdAt       DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([productId])
}

model VendorBill {
  id               String         @id @default(cuid())
  vendorId         String
  vendor           Vendor         @relation(fields: [vendorId], references: [id])
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  billNo           String
  billDate         DateTime
  dueDate          DateTime
  amount           Float
  paidAmount       Float          @default(0)
  status           BillStatus     @default(PENDING)
  lastFollowedUp   DateTime?
  nextFollowUpDate DateTime?
  followUpNotes    String?
  notes            String?
  billedTo         String? // "HUB" or "CENTRE"
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  payments          VendorPayment[]
  issues            VendorIssue[]
  suggestedBankTxns BankTransaction[]  @relation("SuggestedBillTxn")
  inboundShipment   InboundShipment?
  ledgerEntries     BrandLedgerEntry[] // brand statement rows matched to this bill

  @@unique([vendorId, billNo])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
}

model VendorPayment {
  id               String        @id @default(cuid())
  vendorId         String
  vendor           Vendor        @relation(fields: [vendorId], references: [id])
  billId           String?
  bill             VendorBill?   @relation(fields: [billId], references: [id])
  amount           Float
  cdDiscountAmount Float         @default(0) // Cash discount applied
  paymentMode      PaymentMode
  paymentDate      DateTime
  referenceNo      String?
  notes            String?
  creditId         String?
  credit           VendorCredit? @relation(fields: [creditId], references: [id])
  recordedById     String
  recordedBy       User          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt        DateTime      @default(now())

  ledgerEntries BrandLedgerEntry[] // brand statement rows matched to this payment

  @@index([vendorId])
  @@index([billId])
  @@index([paymentDate])
}

model VendorCredit {
  id           String   @id @default(cuid())
  vendorId     String
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  creditNoteNo String
  amount       Float
  usedAmount   Float    @default(0)
  reason       String?
  creditDate   DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments      VendorPayment[]
  ledgerEntries BrandLedgerEntry[] // brand statement rows matched to this credit note

  @@unique([vendorId, creditNoteNo])
  @@index([vendorId])
}

model Expense {
  id           String          @id @default(cuid())
  date         DateTime
  amount       Float
  category     ExpenseCategory
  description  String
  paidBy       String
  paymentMode  PaymentMode
  referenceNo  String?
  receiptUrl   String?
  notes        String?
  recordedById String
  recordedBy   User            @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([date])
  @@index([category])
  @@index([recordedById])
}

// ─── BANK STATEMENT RECONCILIATION ───

enum BankTxnType {
  CREDIT
  DEBIT
}

enum BankTxnMatchStatus {
  UNMATCHED
  MATCHED
  FLAGGED
  EXPENSE
  IGNORED
}

model BankStatement {
  id            String    @id @default(cuid())
  bank          String // HDFC, ICICI
  accountNumber String?
  fileName      String
  fromDate      DateTime?
  toDate        DateTime?
  totalCredits  Float     @default(0)
  totalDebits   Float     @default(0)
  txnCount      Int       @default(0)
  matchedCount  Int       @default(0)
  flaggedCount  Int       @default(0)
  uploadedById  String
  uploadedBy    User      @relation("StatementUploader", fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())

  transactions BankTransaction[]

  @@index([createdAt])
}

model BankTransaction {
  id                 String             @id @default(cuid())
  statementId        String
  statement          BankStatement      @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date               DateTime
  description        String
  reference          String?
  amount             Float
  type               BankTxnType // CREDIT or DEBIT
  balance            Float?
  matchStatus        BankTxnMatchStatus @default(UNMATCHED)
  flagReason         String?
  // AI-suggested matches
  suggestedVendorId  String?
  suggestedVendor    Vendor?            @relation("SuggestedVendorTxn", fields: [suggestedVendorId], references: [id])
  suggestedBillId    String?
  suggestedBill      VendorBill?        @relation("SuggestedBillTxn", fields: [suggestedBillId], references: [id])
  suggestedCategory  String? // For expenses
  confidence         Float? // AI match confidence 0-1
  // Confirmed matches
  confirmedVendorId  String?
  confirmedVendor    Vendor?            @relation("ConfirmedVendorTxn", fields: [confirmedVendorId], references: [id])
  confirmedPaymentId String?
