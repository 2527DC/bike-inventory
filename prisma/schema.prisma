// ═══════════════════════════════════════════════════════════════════════════════
// SERVICE / WORKSHOP
// Merged in from the standalone bch-service app.
//
// What did NOT come across:
//   * its `User` model      — the inventory User is the single account table. Service staff
//                             are ordinary users holding a SERVICE_* role.
//   * its `UserRole` enum   — replaced by the `roles` table (see the RBAC block at the top).
//   * its `Customer` model  — folded into the shared Customer above.
// ═══════════════════════════════════════════════════════════════════════════════

enum JobStatus {
  RECEIVED // bike dropped off
  PARTS_NEEDED // waiting for parts, kept aside
  READY // work done, ready for pickup
  DELIVERED // collected and paid
}

enum JobType {
  QFX // quick fix
  PSVC // paid service
  RSVC // repair & service
  FSVC // free service
  A50 // 50% assembly
  A85 // 85% assembly
  FULL // full fitting
  SND // second-hand repair
  WSH // wash
  ECYC // e-cycle service
}

enum PaymentStatus {
  UNPAID
  CREDIT
  PAID
}

model ServiceJob {
  id           String    @id @default(cuid())
  tokenNumber  String    @unique // BCH-0001, minted from TokenCounter
  status       JobStatus @default(RECEIVED)
  jobType      JobType
  estimatedHrs Float     @default(1.0)

  // Bike
  bikeType  String
  bikeColor String?
  isEcycle  Boolean @default(false)
  complaint String?

  // Work
  diagnosis   String?
  partsNeeded String?
  workDone    String?

  // Timestamps drive TAT reporting
  receivedAt  DateTime  @default(now())
  promisedAt  DateTime?
  partsAt     DateTime?
  readyAt     DateTime?
  deliveredAt DateTime?

  holdReason String?
  notes      String?

  // Payment
  paymentStatus PaymentStatus @default(UNPAID)
  amount        Float?
  zohoInvoiceId String?

  // Nightly Zoho auto-deliver proposal, cleared on staff approval
  deliveryMatchedInvoice String?
  deliveryProposedAt     DateTime?
  deliveryReviewedAt     DateTime?

  photos      String[] @default([])
  afterPhotos String[] @default([])

  priority Int @default(0) // 0 normal, 1 urgent

  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  mechanicId  String?
  mechanic    User?    @relation("ServiceJobMechanic", fields: [mechanicId], references: [id])
  createdById String
  createdBy   User     @relation("ServiceJobCreatedBy", fields: [createdById], references: [id])
  review      Review?

  @@index([status])
  @@index([mechanicId])
  @@index([receivedAt])
  @@index([customerId])
  @@map("service_jobs")
}

model Review {
  id           String   @id @default(cuid())
  rating       Int // 1-5
  comment      String?
  googleReview Boolean  @default(false)
  createdAt    DateTime @default(now())

  jobId      String     @unique
  job        ServiceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id])
  mechanicId String
  mechanic   User       @relation("ServiceReviewMechanic", fields: [mechanicId], references: [id])

  @@index([mechanicId])
  @@map("reviews")
}

model TaskAssignment {
  id          String    @id @default(cuid())
  date        DateTime
  mechanicId  String
  // The standalone app left this as a bare string with no FK, so a deleted mechanic left
  // orphan rows behind. Made a real relation during the merge.
  mechanic    User      @relation("TaskAssignmentMechanic", fields: [mechanicId], references: [id])
  description String
  jobType     JobType
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([date, mechanicId])
  @@map("task_assignments")
}

model PriceItem {
  id        String   @id @default(cuid())
  name      String
  category  String // SERVICE | PARTS
  wheelSize String? // null = all sizes; "14","20","24","26","27.5","29","ECYCLE"
  price     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([wheelSize])
  @@map("price_items")
}

model AssemblyLog {
  id           String   @id @default(cuid())
  mechanicId   String
  mechanic     User     @relation("AssemblyMechanic", fields: [mechanicId], references: [id])
  assemblyType String // A50 | A85 | FULL
  bikeModel    String?
  notes        String?
  photos       String[] @default([])
  createdAt    DateTime @default(now())

  @@index([mechanicId])
  @@index([createdAt])
  @@map("assembly_logs")
}

// Single-row counter minting sequential job tokens. Increments MUST run inside a transaction
// with a row lock — tokenNumber is unique, so a concurrent read-then-write hands two jobs the
// same token and the second insert fails in front of a customer at the counter.
model TokenCounter {
  id      String @id @default("default")
  current Int    @default(0)

  @@map("token_counter")
}

// Service-side audit trail. Kept as its own table rather than folded into OpsActivityLog,
// per the merge decision to keep logs separate for now.
model ServiceAuditLog {
  id         String   @id @default(cuid())
  jobId      String
  action     String // STATUS_CHANGE, PHOTO_DELETE, JOB_DELETE, ...
  fromStatus String?
  toStatus   String?
  details    String?
  userId     String
  userName   String
  userRole   String // role name captured at the time of the action
  createdAt  DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@map("service_audit_logs")
}

model NotificationLog {
  id            String   @id @default(cuid())
  jobId         String
  tokenNumber   String
  customerPhone String
  customerName  String
  messageType   String // INWARD | PARTS_NEEDED | READY | DELIVERED
  sentById      String
  sentByName    String
  createdAt     DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
  @@map("notification_logs")
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// BRAND LEDGER RECONCILIATION
// Merged in from the standalone `ledgers` workspace.
//
// The job: every brand promised discounts and credit notes. Did they actually credit them,
// and what do we really owe?
//
//     Net payable = ledger due âˆ’ unrecorded payments âˆ’ promised discounts not yet credited
//
// THE ONE RULE THAT MAKES THIS WORK â€” two sides, stored separately:
//
//   BrandLedgerEntry            what the BRAND says, transcribed from their statement
//   VendorBill/Payment/Credit   what BCH's own books say
//   LedgerGap                   the difference worth chasing
//
// An import NEVER edits the brand's numbers and NEVER writes into BCH's books. If their
// statement is wrong, that wrongness IS the finding â€” "correcting" it on import destroys the
// evidence needed to prove it. And letting an import create a VendorBill would turn their
// mistake into our accounting record â€” exactly the EMotorad two-folio problem, where invoices
// were posted to Hub and payments to Centre, so neither folio alone was ever right.
//
// Attached to Vendor, not Brand: we pay the billing entity, and brand != entity. Raleigh is
// billed via Naren International; EMotorad via Inkodop Technologies.
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•

enum LedgerEntryType {
  OPENING
  INVOICE
  PAYMENT
  CREDIT_NOTE
  DEBIT_NOTE
  DISCOUNT
  ADJUSTMENT
}

// Which party the entry originates from â€” separates "their invoice" from "our payment".
enum LedgerSide {
  VENDOR
  BCH
}

// How a statement row relates to BCH's own books.
//
// NEEDS_REVIEW deliberately does NOT mean "discrepancy": an unmatched row is ambiguous between
// "they never posted our payment" and "we never recorded it". Only a human can tell which, so
// the system surfaces and never concludes.
enum LedgerMatchStatus {
  UNMATCHED
  MATCHED
  NEEDS_REVIEW
  THEY_MISSING // we paid or were credited; absent from their statement
  WE_MISSING // on their statement; absent from our books
  DISPUTED
  IGNORED
}

enum LedgerEntrySource {
  STATEMENT_PDF
  STATEMENT_XLSX
  STATEMENT_CSV
  BCH_BOOKS // mirrored from VendorBill / VendorPayment / VendorCredit
  MANUAL // escape hatch: real, but not yet recorded in Accounts
}

enum GapType {
  DISCOUNT_PENDING
  CREDIT_NOTE_PENDING
  SHORT_CREDIT
  DISPUTE
  RECONCILIATION_DIFFERENCE
  DOCUMENTATION_GAP
  BALANCE_UNCONFIRMED
  SCHEME_ENTITLEMENT
  COMMITMENT_PENDING
  OPERATIONAL_WARRANTY
  INVOICE_DISCREPANCY
  REIMBURSEMENT_PENDING
}

// How hard a claim can be pressed.
//   FIRM        provable in writing
//   LEVERAGE    use in negotiation, not provable
//   VERIFY      needs a document before claiming
//   CONDITIONAL only worth raising if contested
enum GapTier {
  FIRM
  LEVERAGE
  VERIFY
  CONDITIONAL
}

enum GapStatus {
  OPEN // not acknowledged by the brand
  PROMISED // they agreed; credit note not yet issued
  VERIFY // needs checking against a document or bank statement
  RESOLVED
  REJECTED
}

enum EvidenceKind {
  SCREENSHOT
  PDF
  EMAIL
  DOCUMENT
}

enum DiscountKind {
  CASH // early payment: "2% within 15 days"
  TRADE // off list price: "18% on alloy frames"
  VOLUME
  TRANSPORT_SUPPORT // "Rs 150 per cycle"
  MARKETING
  INCENTIVE // "Rs 1,200 per bike billed"
  OTHER
}

// A brand's own statement rows, exactly as received. Never edited to match our books.
model BrandLedgerEntry {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  brandId  String? // which brand the row concerns, when a vendor supplies several
  brand    Brand?  @relation("BrandLedgerEntries", fields: [brandId], references: [id])

  entryDate DateTime
  type      LedgerEntryType
  ref       String? // their voucher / invoice number
  amount    Float

  // +1 increases what BCH owes (invoice, debit note); -1 decreases (payment, CN, discount).
  // Stored rather than derived from `type` because brands occasionally post a credit on a
  // sales voucher, and the running balance depends on the sign rather than the label.
  direction Int

  side   LedgerSide
  note   String?
  source LedgerEntrySource @default(STATEMENT_CSV)

  // Per-invoice discount audit â€” the "18% via DIS-90, group short 539" annotations.
  auditStatus String? // ok | short | missing | era20 | info
  auditNote   String?

  // Reconciliation against BCH's books. All null and UNMATCHED until matched.
  matchStatus LedgerMatchStatus @default(UNMATCHED)
  billId      String?
  bill        VendorBill?       @relation(fields: [billId], references: [id])
  paymentId   String?
  payment     VendorPayment?    @relation(fields: [paymentId], references: [id])
  creditId    String?
  credit      VendorCredit?     @relation(fields: [creditId], references: [id])
  reviewedAt  DateTime?
  reviewNote  String?

  gapId String? // an annotated row can evidence a claim
  gap   LedgerGap? @relation("GapEntries", fields: [gapId], references: [id])

  statementId String?
  statement   BrandStatement? @relation(fields: [statementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId, entryDate])
  @@index([vendorId, matchStatus])
  @@index([statementId])
  @@index([gapId])
  @@map("brand_ledger_entries")
}

// Provenance for an import: which statement produced which rows, so a re-import is auditable
// and a revised statement can supersede an older one.
model BrandStatement {
  id            String    @id @default(cuid())
  vendorId      String
  vendor        Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  statementDate DateTime
  periodFrom    DateTime?
  periodTo      DateTime?

  // What THEY claim the closing balance is, against what summing their own rows produces.
  // A mismatch means the statement does not add up â€” that is a finding, and it blocks the
  // import until someone looks at it.
  claimedClosing  Float?
  computedClosing Float?
  tiesOut         Boolean @default(false)

  fileUrl    String? // the original PDF / XLSX in R2
  fileName   String?
  sourceKind LedgerEntrySource @default(STATEMENT_CSV)

  // Recorded so an AI extraction can be re-checked against what was actually returned.
  extractionModel String?
  extractionNote  String?

  importedById String
  importedBy   User     @relation("StatementImportedBy", fields: [importedById], references: [id])
  createdAt    DateTime @default(now())

  entries BrandLedgerEntry[]

  @@index([vendorId, statementDate])
  @@map("brand_statements")
}

// The claim register â€” the heart of the tool. One row per unresolved money claim.
model LedgerGap {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  brandId  String?
  brand    Brand?  @relation("BrandLedgerGaps", fields: [brandId], references: [id])

  number Int // per-brand #1, #2 â€¦ preserved from the existing register
  title  String

  gapType GapType
  tier    GapTier?
  status  GapStatus @default(OPEN)

  amount Float?

  // Free text for amounts that are not a single number â€” "10,300 claimed / 9,900 itemised".
  // The imprecision is the point; forcing it into a Float would invent certainty.
  amountNote String?

  promisedBy   String? // who at the brand
  promisedOn   DateTime?
  evidenceText String? // curated citation: chat dates, line refs, quotes
  action       String? // next step
  result       String? // what happened
  resolvedAt   DateTime?

  createdById String
  createdBy   User     @relation("LedgerGapCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  evidence LedgerGapEvidence[]
  entries  BrandLedgerEntry[]  @relation("GapEntries")
  notes    LedgerGapNote[]

  @@unique([vendorId, number])
  @@index([vendorId, status])
  @@index([status, gapType])
  @@map("ledger_gaps")
}

model LedgerGapEvidence {
  id           String       @id @default(cuid())
  gapId        String
  gap          LedgerGap    @relation(fields: [gapId], references: [id], onDelete: Cascade)
  url          String // R2
  kind         EvidenceKind
  capturedOn   DateTime? // when the evidence event happened, not when it was uploaded
  source       String? // "Mani WhatsApp chat (L1600)"
  note         String? // what it proves
  uploadedById String?
  uploadedBy   User?        @relation("GapEvidenceUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([gapId])
  @@map("ledger_gap_evidence")
}

// Progress log on a claim â€” chases, replies, changes of position.
model LedgerGapNote {
  id        String    @id @default(cuid())
  gapId     String
  gap       LedgerGap @relation(fields: [gapId], references: [id], onDelete: Cascade)
  body      String
  authorId  String
  author    User      @relation("LedgerGapNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime  @default(now())

  @@index([gapId])
  @@map("ledger_gap_notes")
}

// What was actually agreed with a supplier â€” the missing half of the discount audit.
//
// Vendor.cdPercentage / cdTermsDays models only a CASH discount ("2% within 15 days"). It
// cannot express "18% on alloy, 20% on steel, from July 2025, plus Rs 150/cycle transport" â€”
// and that is what the Hornback and Lucifer disputes are actually about. With these rows the
// app COMPUTES the expected discount per invoice instead of the shortfall being hand-typed.
//
// An empty agreedBy / evidenceUrl is itself the signal: the term is unproven. That is what
// "Need: written 20% agreement to claim Dispute #1" is warning about, surfaced before the
// negotiation rather than during it.
model VendorDiscountTerm {
  id       String  @id @default(cuid())
  vendorId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  brandId  String?
  brand    Brand?  @relation("BrandDiscountTerms", fields: [brandId], references: [id])

  kind          DiscountKind
  percentage    Float?
  perUnitAmount Float? // "Rs 150 per cycle"
  appliesTo     String? // "alloy frames", "steel frames", "kids bills"

  // Terms change. Hornback's discount applies "only from July-2025"; Lucifer moved 20% -> 18%.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  // Cash discounts need a payment window; trade discounts do not.
  withinDays Int?

  agreedBy    String? // who promised it
  agreedOn    DateTime?
  isProven    Boolean   @default(false) // is there anything in writing?
  evidenceUrl String?
  notes       String?

  createdById String
  createdBy   User     @relation("DiscountTermCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vendorId, kind])
  @@index([vendorId, effectiveFrom])
  @@map("vendor_discount_terms")
}

// Brand <-> Vendor, many-to-many. One distributor supplies several brands (Naren -> Raleigh
// and Suncross), and a brand can arrive through more than one vendor. An explicit join rather
// than an implicit m-n so the pairing can carry its own context.
model BrandVendor {
  id       String @id @default(cuid())
  brandId  String
  brand    Brand  @relation("BrandVendors", fields: [brandId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation("VendorBrands", fields: [vendorId], references: [id], onDelete: Cascade)

  isPrimary Boolean  @default(false) // the usual billing route for this brand
  note      String? // "distributor", "direct", "via Ludhiana"
  createdAt DateTime @default(now())

  @@unique([brandId, vendorId])
  @@index([vendorId])
  @@map("brand_vendors")
}

// ─── Store Analytics (merged from bch-store-analytics) ───────────────────────
// Entrance footfall. A Python agent on the store laptop watches the door camera, counts line
// crossings, and pushes anonymous events here over outbound HTTPS. The agent is NOT part of
// this app and is not merged — inference stays on-premises. See docs/analytics-merge-plan.md
// §8 for why: the camera is deliberately unreachable from the internet, raw video would be
// ~43 GB/store/day upstream, and counting must survive a broadband outage.
//
// No image, frame or video ever reaches this database. Only counts.
//
// Spec IDs cited below (DAT-001, DAT-004, DAT-005) refer to docs/analytics/pilot/PRD-v1.md,
// carried across with the code so the citations still resolve.

enum CountDirection {
  IN
  OUT
}

// One confirmed crossing of the counting line at a store entrance.
model CountEvent {
  // NOT @default(cuid()). The agent supplies this UUID and it IS the idempotency key
  // (DAT-001): the agent retries a batch until the server acks, so the same event arrives
  // more than once by design, and the primary key is what collapses the retries into one row.
  // Generating it here would turn every retry into another person walking through the door.
  id String @id

  storeId    StockLocation
  entranceId String         @default("main") // a store may grow a second door
  direction  CountDirection

  eventTs    DateTime // when the crossing happened, by the agent's clock
  receivedTs DateTime @default(now()) // when the server accepted it — these diverge after an outage

  // Store-local (Asia/Kolkata) calendar day, computed on ingest — DAT-004. Deliberately a
  // DATE and not a DateTime: Vercel runs UTC, so deriving the day from a timestamp at read
  // time puts every event after 18:30 UTC on the wrong business day.
  businessDate DateTime @db.Date

  count Int @default(1) // always 1 today; a group-counting adapter could emit more

  // Provenance, so a suspicious count can be reviewed rather than argued about.
  deviceId      String?
  device        AnalyticsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  adapter       String           @default("RTSP_CV") // RTSP_CV today; a dedicated door counter later
  trackId       String?
  confidence    Float?
  agentVersion  String?
  configVersion String?

  // Free text rather than an enum: the pilot has only ever written "ok" and the taxonomy of
  // quality flags is still open. Promote to an enum once the real values are known.
  quality String @default("ok")

  @@index([storeId, businessDate])
  @@index([deviceId])
  @@map("count_events")
}

// Agent liveness, kept as a SERIES and not one current value. Two reasons: the gap between
// heartbeats is what raises the "counter offline" alert, and the count of distinct
// heartbeat-minutes in a day is the denominator of data coverage (DAT-005).
model AgentHeartbeat {
  id String @id @default(cuid())

  storeId StockLocation
  agentId String        @default("edge-1")

  deviceId String?
  device   AnalyticsDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  ts           DateTime @default(now())
  businessDate DateTime @db.Date

  queueDepth   Int? // events still waiting in the agent's local SQLite buffer
  cameraOk     Boolean? // is the RTSP stream still producing frames
  lastFrameTs  DateTime?
  agentVersion String?

  @@index([storeId, ts(sort: Desc)])
  @@index([storeId, businessDate])
  @@index([deviceId])
  @@map("heartbeats")
}

// A counting device authorised to write events. Replaces the STORE_KEYS environment JSON the
// pilot used, so a camera key can be rotated from an admin screen instead of a redeploy —
// "access control is DATA, not code" (CLAUDE.md).
model AnalyticsDevice {
  id      String        @id @default(cuid())
  storeId StockLocation
  agentId String        @default("edge-1")
  label   String // "BCH front door laptop"

  // sha-256 of the API key. The key itself is shown once at creation and never stored, so a
  // database leak does not hand anyone the ability to forge footfall.
  keyHash String @unique

  isActive   Boolean   @default(true)
  lastSeenAt DateTime? // updated on each heartbeat; drives the device list
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  countEvents CountEvent[]
  heartbeats  AgentHeartbeat[]

  @@unique([storeId, agentId]) // one agent per door per store
  @@index([isActive])
  @@map("analytics_devices")
}

// Per-store daily rollup. count_events grows by one row per person per direction forever and
// the dashboard polls every 15s, so past days must not re-aggregate the raw table.
model FootfallDaily {
  id      String        @id @default(cuid())
  storeId StockLocation

  businessDate DateTime @db.Date

  inCount  Int @default(0)
  outCount Int @default(0)

  // Distinct minutes that carried a heartbeat. Coverage % = observed ÷ expected open minutes
  // (DAT-005). Missing data is not zero traffic: a gap renders as unknown, never as 0.
  observedMinutes Int @default(0)

  // Snapshotted from POS at rollup time. TWO counts, never summed — counterBills is the one
  // that pairs with footfall; totalInvoices includes credit sales and business that never
  // walked through the door.
  counterBills  Int?
  totalInvoices Int?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([storeId, businessDate])
  @@map("footfall_daily")
}
