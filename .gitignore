# Captured API responses kept for debugging. Real data from the live database — never
# committed. Add the sample here rather than deleting it; the capacity notes in
# docs/implementation/pending/zoho-provider-endpoint-registry-plan.md are measured from it.
/docs/stock-fetch-response.json

# AI agent tooling — machine-local state, not project source
/.claude-flow/
/.ruflo/
/.swarm/
/.claude/projects/
/.claude/settings.local.json

# Import source data — supplier cost prices, not project source.
# `prisma/data/Item.xls` is 2.2 MB of purchase and selling prices for 8,175 SKUs.
# It feeds scripts/import-products.ts and must not enter git history.
/prisma/data/
