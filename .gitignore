# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Photos, spreadsheets and PDFs — never committed (owner, 13 Oct 2026). Bank statements,
# ledgers, invoices, stock sheets and screenshots are business data, not project source.
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.heic
*.heif
*.bmp
*.tif
*.tiff
*.pdf
*.xls
*.xlsx
*.xlsm
*.xlsb
*.ods
*.numbers
*.csv
# ...except the images the app itself serves: the logo, the PWA icons and the favicons.
# Image types only — a PDF or spreadsheet dropped into public/ would be publicly downloadable.
!/public/**/*.png
!/public/**/*.jpg
!/public/**/*.jpeg
!/public/**/*.gif
!/public/**/*.webp
!/src/app/**/*.png
!/src/app/**/*.jpg
!/src/app/**/*.jpeg

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Captured API responses kept for debugging. Real data from the live database — never
# committed. Add the sample here rather than deleting it; the capacity notes in
# docs/implementation/pending/zoho-provider-endpoint-registry-plan.md are measured from it.
/docs/stock-fetch-response.json

# AI agent tooling — machine-local state, not project source
/.claude-flow/
/.ruflo/
/.swarm/
/.claude/projects/
/.claude/settings.local.json

# Import source data — supplier cost prices, not project source.
# `prisma/data/Item.xls` is 2.2 MB of purchase and selling prices for 8,175 SKUs.
# It feeds scripts/import-products.ts and must not enter git history.
/prisma/data/

# Database snapshots — never leave this machine
backups/

# Local storage provider (StorageConfig provider = LOCAL, default dir .storage): uploaded
# statements, chat exports and evidence. Real supplier data — never committed.
/.storage/
