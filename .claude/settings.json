{
  "permissions": {
    "ask": [
      "Bash(git:*)",
      "Bash(git *)",
      "Bash(npm:*)",
      "Bash(npm *)",
      "PowerShell(git:*)",
      "PowerShell(git *)",
      "PowerShell(npm:*)",
      "PowerShell(npm *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/ask-git-npm.js\"",
            "timeout": 15,
            "statusMessage": "Checking git/npm approval rule..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo '⚠️ FILE CHANGED — Remember: run npm run build and verify on the page before saying done.'",
            "statusMessage": "Reminding to build and verify..."
          }
        ]
      }
    ]
  }
}
